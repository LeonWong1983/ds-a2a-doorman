{
  "name": "dsh-a2a-doorman",
  "version": "0.1.0",
  "description": "A2A doorman: a global doorman_relay tool that bridges inbound A2A messages into a watched DeepSeek Harness session and returns that session's reply.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "a2a",
    "agent2agent",
    "bridge",
    "relay"
  ],
  "homepage": "https://github.com/LeonWong1983/ds-a2a-doorman#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonWong1983/ds-a2a-doorman.git",
    "directory": "bundle/dsh-a2a-doorman"
  },
  "bugs": {
    "url": "https://github.com/LeonWong1983/ds-a2a-doorman/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
